# The tools the packaging downloads, pinned to a release and checked against
# the SHA-256 the release publishes for each file. Change a version only
# together with its hashes (gh release view TAG --json assets shows them).

# uruntime (VHSgunzo/uruntime): the static runtime the single-file build is
# made from. The RunImage squashfs variant: it runs Run.sh from the image and
# is not tied to the AppImage format or its tools.
URUNTIME_VERSION=v0.8.1
URUNTIME_SHA256_x86_64=0caf994fce15afab855770026d2ace133da5f9fc4078168acc7a0a531b73ccda
URUNTIME_SHA256_aarch64=34269cb6445aa6ef3f7b99c01da36f9412e42d3407c2206b4568507a3d51e1d8

# nfpm (goreleaser/nfpm): makes the .deb and the .rpm from nfpm.yaml.
NFPM_VERSION=2.47.0
NFPM_SHA256_x86_64=0660ca602b2d2d2ae4781a06c692b3eeb9d437ffea05b831d76e41f4a3188783
NFPM_SHA256_aarch64=1c0f5f2999b9a974bfb04fdb0cc3306096de530ac5dbb25d739cc5f5219c919c
